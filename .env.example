# ==========================================================================
# Variables de despliegue del frontend (Docker / nginx).
# Copia este archivo a .env:  cp .env.example .env
#
# BACKEND_URL se lee AL ARRANCAR el contenedor (docker/40-env-js.sh genera
# /env.js) y el navegador llama directamente a ${BACKEND_URL}/api.
#   - Debe ser la URL PÚBLICA del backend (la que abre el navegador), no un
#     nombre interno de Docker.
#   - En el backend, CORS_ORIGIN debe incluir el dominio de este frontend.
#   - Desarrollo (ng serve): usa http://localhost:3000/api (environment.development.ts).
# FRONTEND_PORT lo consume el docker-compose del stack.
# ==========================================================================

# Puerto publicado en el host para el portal
FRONTEND_PORT=8080

# URL pública del backend, sin /api ni barra final.
# Ejemplos: http://localhost:3000 (docker-compose local, valor por defecto)
#           https://api-cancha.midominio.com (Easypanel / producción)
BACKEND_URL=http://localhost:3000

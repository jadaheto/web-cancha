# ==========================================================================
# Variables de despliegue del frontend (Docker / nginx).
# Copia este archivo a .env:  cp .env.example .env
#
# Nota: Angular NO lee .env en tiempo de ejecución. La URL de la API se define
# en src/environments/environment*.ts:
#   - Producción (Docker): apiUrl = "/api"  -> nginx hace proxy al backend.
#   - Desarrollo (ng serve): apiUrl = "http://localhost:3000/api".
# FRONTEND_PORT lo consume el docker-compose del stack; BACKEND_URL, nginx
# al arrancar el contenedor.
# ==========================================================================

# Puerto publicado en el host para el portal
FRONTEND_PORT=8080

# URL del backend a la que nginx hace proxy en /api/. Sin ruta ni barra final.
# Ejemplos: http://backend:3000 (docker-compose, valor por defecto)
#           http://proyecto_servicio:3000 (red interna de Easypanel)
#           https://api.midominio.com (dominio público)
BACKEND_URL=http://backend:3000
